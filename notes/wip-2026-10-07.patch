+/// No body ever sleeps. Avian 0.7.0's island wake-up can register a contact's
+/// manifolds with the solver twice; the solver then indexes past the end of the
+/// manifold list (`solver/plugin.rs:398`, "index out of bounds: the len is 2 but the
+/// index is 2") — it crashed when Rico landed on a tile that had just streamed in.
+fn never_sleep(add: On<Add, RigidBody>, mut commands: Commands) {
+    commands.entity(add.entity).insert(SleepingDisabled);
+}
